# ============================================================
# FOLEXO — Invoice AI | Environment configuration template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# ─── Application ─────────────────────────────────────────────
APP_ENV=development                       # development | staging | production
APP_BASE_URL=http://localhost:8000        # FastAPI base URL
FRONTEND_BASE_URL=http://localhost:3000   # Next.js base URL
ALLOWED_ORIGINS=http://localhost:3000     # CORS origins, comma-separated
LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR
REQUEST_TIMEOUT_SECONDS=30

# ─── Supabase (Dashboard → Project Settings → API) ───────────
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key   # backend only — bypasses RLS
SUPABASE_JWT_SECRET=your-supabase-jwt-secret               # HS256 verification (legacy signing)
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-ref.supabase.co:5432/postgres
SUPABASE_STORAGE_BUCKET=invoices                           # private bucket for source documents

# ─── JWT verification (ADR-004) ──────────────────────────────
JWT_ALGORITHM=HS256                       # HS256 (legacy) or RS256 (Supabase JWT signing keys)
JWT_PUBLIC_KEY=                           # PEM public key — required when JWT_ALGORITHM=RS256
JWT_AUDIENCE=authenticated
# JWT_ISSUER=                              # defaults to {SUPABASE_URL}/auth/v1 when unset
JWT_LEEWAY_SECONDS=10

# ─── Redis (async pipeline broker for ARQ) ───────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Azure AI Document Intelligence (Stage A extraction) ─────
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://YOUR-RESOURCE-NAME.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=your-azure-di-api-key
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-invoice

# ─── OpenAI (Stage B conditional fallback) ───────────────────
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# ─── Extraction tuning ───────────────────────────────────────
# Critical fields below this confidence trigger the OpenAI fallback stage (docs/ARCHITECTURE.md §6)
EXTRACTION_CONFIDENCE_THRESHOLD=0.85
MAX_UPLOAD_SIZE_MB=25
MAX_UPLOAD_PAGES=100
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BACKOFF_SECONDS=10
